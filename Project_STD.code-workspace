{
    "folders": [
        {
            "path": "."
        },
        {
            "path": "../STM32F407-Bootloader"
        },
        {
            "path": "../STM32F407-Recovery"
        }
    ],
    "settings": {
        "terminal.integrated.shellIntegration.enabled": false,
        "files.autoGuessEncoding": true,
        "C_Cpp.default.configurationProvider": "cl.eide",
        "C_Cpp.errorSquiggles": "disabled",
        "files.associations": {
            ".eideignore": "ignore",
            "*.a51": "a51",
            "*.h": "c",
            "*.c": "c",
            "*.hxx": "cpp",
            "*.hpp": "cpp",
            "*.c++": "cpp",
            "*.cpp": "cpp",
            "*.cxx": "cpp",
            "*.cc": "cpp"
        },
        "[yaml]": {
            "editor.insertSpaces": true,
            "editor.tabSize": 4,
            "editor.autoIndent": "advanced"
        },
        "cortex-debug.variableUseNaturalFormat": false,
        "editor.semanticHighlighting.enabled": true,
        "editor.semanticTokenColorCustomizations": {
            "enabled": true,
            "rules": {
                "namespace": "#4EC9B0",
                "type": "#4EC9B0",
                "class": "#4EC9B0",
                "struct": "#4EC9B0",
                "enum": "#4EC9B0",
                "typeParameter": {
                    "foreground": "#4EC9B0",
                    "italic": true
                },
                "enumMember": "#B5CEA8",
                "function": "#DCDCAA",
                "method": "#DCDCAA",
                "macro": "#BD93F9",
                "variable": "#9CDCFE",
                "property": "#9CDCFE",
                "parameter": {
                    "foreground": "#9CDCFE",
                    "italic": true
                },
                "variable.readonly": "#4FC1FF",
                "parameter.readonly": "#4FC1FF",
                "keyword": "#569CD6",
                "string": "#CE9178",
                "number": "#B5CEA8",
                "comment": {
                    "foreground": "#6A9955",
                    "italic": true
                },
                "operator": "#D4D4D4"
            }
        }
    },
    "extensions": {
        "recommendations": [
            "cl.eide",
            "keroc.hex-fmt",
            "xiaoyongdong.srecord",
            "hars.cppsnippets",
            "zixuanwang.linkerscript",
            "redhat.vscode-yaml",
            "IBM.output-colorizer",
            "cschlosser.doxdocgen",
            "ms-vscode.vscode-serial-monitor",
            "dan-c-underwood.arm",
            "marus25.cortex-debug"
        ]
    }
}