 #include <stdbool.h> #include <stdint.h> #include "app_dispatch.h" #include "app_render.h" #define YN_OL_STX (0x7BU) #define YN_OL_ETX (0x7DU) #define YN_OL_HEAD_LEN (3U) #define YN_OL_CMD_OFFSET (1U) #define YN_OL_LEN_OFFSET (2U) #define YN_OL_DATA_OFFSET (3U) #define YN_OL_FRAME_OVERHEAD (4U) #define YN_OL_FRAME_LEN_MIN (4U) #define YN_OL_PAYLOAD_MAX (255U) #define YN_OL_FRAME_LEN_MAX (YN_OL_PAYLOAD_MAX + YN_OL_FRAME_OVERHEAD) #define YN_OL_QUEUE_DEPTH (3U) #define YN_OL_MSG_SIZE (sizeof(frame_msg_t) + YN_OL_FRAME_LEN_MAX) _Static_assert(YN_OL_FRAME_LEN_MAX <= RB_SIZE_RS485, "YN_OL frame must fit RS485 RB"); _Static_assert(YN_OL_FRAME_LEN_MAX <= RB_SIZE_RS232, "YN_OL frame must fit RS232 RB"); _Static_assert(YN_OL_FRAME_LEN_MAX <= RB_SIZE_RJ45, "YN_OL frame must fit RJ45 RB (UDP 10011)"); #define YN_OL_ONE_LINE_PREFIX_LEN (2U) #define YN_OL_FULL_SCREEN_PREFIX_LEN (3U) #define YN_OL_SCREEN_PARAM_LEN (2U) #define YN_OL_NET_PAYLOAD_LEN (14U) typedef enum { YN_OL_PCMD_HOST_QUERY = '1', YN_OL_PCMD_SELF_CHECK = '2', YN_OL_PCMD_ONE_LINE = '3', YN_OL_PCMD_FULL_SCREEN = '4', YN_OL_PCMD_CLEAR = '5', YN_OL_PCMD_BRIGHTNESS = '8', YN_OL_PCMD_PERIPHERAL = 'A', YN_OL_PCMD_CLEAR_ROW1 = 0x42, YN_OL_PCMD_CLEAR_ROW2 = 0x43, YN_OL_PCMD_CLEAR_ROW3 = 0x44, YN_OL_PCMD_CLEAR_ROW4 = 0x45, YN_OL_PCMD_CLEAR_ROW5 = 0x46, YN_OL_PCMD_SET_IP = 0x47, YN_OL_PCMD_GET_IP = 0x48, YN_OL_PCMD_SCREEN_PARAM = 0x49, YN_OL_PCMD_CLEAR_ROW6 = 0x50, YN_OL_PCMD_GET_IP_ACK = 0x51, YN_OL_PCMD_FILL_ALL = 0x01, YN_OL_PCMD_VERSION = 0x02, YN_OL_PCMD_INVALID = 0xFF, } yn_ol_pcmd_t; typedef enum { YN_OL_PARSE_OK = 0, YN_OL_PARSE_ERR_FRAME, YN_OL_PARSE_ERR_CMD, YN_OL_PARSE_ERR_PARAM, } yn_ol_parse_sta_t; typedef enum { YN_OL_EXEC_OK = 0, YN_OL_EXEC_NO_DISPLAY = -1, YN_OL_EXEC_BAD_PARAM = -2, YN_OL_EXEC_NOT_RUN = -3, YN_OL_EXEC_NOT_MATCH = -4, } yn_ol_exec_ret_t; typedef struct { uint8_t color; uint8_t row; const uint8_t *text; uint16_t text_len; } yn_ol_one_line_t; typedef struct { uint8_t color; uint8_t x; uint8_t y; const uint8_t *text; uint16_t text_len; } yn_ol_full_screen_t; typedef struct { uint8_t ip[4]; uint8_t mask[4]; uint8_t gw[4]; uint16_t port; } yn_ol_setip_t; typedef struct { font_type_t font_type; font_size_t font_size; } yn_ol_screen_param_t; #define YN_OL_CFG_MAGIC (0x594E4F4CU) #define YN_OL_CFG_VERSION (1U) #define YN_OL_CFG_SECTOR_OFFSET (12288U) typedef struct { uint32_t magic; uint16_t version; uint8_t font_type; uint8_t font_size; uint32_t crc32; } yn_ol_screen_cfg_record_t; #define YN_OL_CFG_RECORD_SIZE (12U) _Static_assert(sizeof(yn_ol_screen_cfg_record_t) == YN_OL_CFG_RECORD_SIZE, "yn_ol_screen_cfg_record_t must be 12B"); typedef struct { yn_ol_pcmd_t cmd; yn_ol_parse_sta_t sta; uint16_t data_len; const uint8_t *data; union { yn_ol_one_line_t one_line; yn_ol_full_screen_t full_screen; yn_ol_setip_t setip; yn_ol_screen_param_t screen; uint8_t clear_row; uint8_t brightness; uint8_t peripheral; uint8_t fill_color; } p; } yn_ol_parsed_cmd_t; yn_ol_pcmd_t yn_ol_cmd_from_byte(uint8_t c); yn_ol_parsed_cmd_t yn_ol_parse_frame(const uint8_t *raw, uint16_t raw_len); int yn_ol_execute_cmd(channel_t *ch, const yn_ol_parsed_cmd_t *cmd); font_size_t yn_ol_current_font_size(void); font_type_t yn_ol_current_font_type(void); bool yn_ol_screen_cfg_load(void); bool yn_ol_screen_cfg_save(void); void yn_ol_proto_handle_task(void *argument); void yn_ol_proto_init(void); 