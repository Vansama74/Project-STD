#include "app_mm_proto.h" #include <string.h> #include "pl_gpio.h" typedef struct { const char *contact; const char *lamp_name; pl_port_t port; uint8_t pin; bool active_low; } mm_lamp_map_t; static const mm_lamp_map_t s_mm_lamp_map[MM_LAMP_COUNT] = { [MM_LAMP_RED] = {.contact = "S1", .lamp_name = "红灯", .port = PL_PORT_E, .pin = 12, .active_low = false}, [MM_LAMP_LEFT] = {.contact = "S2", .lamp_name = "左下箭头灯", .port = PL_PORT_E, .pin = 11, .active_low = false}, [MM_LAMP_RIGHT] = {.contact = "S3", .lamp_name = "右下箭头灯", .port = PL_PORT_E, .pin = 10, .active_low = false}, }; static bool s_mm_lamp_state[MM_LAMP_COUNT]; static volatile bool s_mm_arrow_swapped; static void _mm_drive(const mm_lamp_map_t *m, bool on) { pl_gpio_write(m->port, m->pin, on != m->active_low); } void mm_apply_lamp(mm_lamp_t lamp, bool on) { if ((unsigned)lamp >= (unsigned)MM_LAMP_COUNT) return; const mm_lamp_map_t *m = &s_mm_lamp_map[lamp]; _mm_drive(m, on); s_mm_lamp_state[lamp] = on; } void mm_apply_init(void) { s_mm_arrow_swapped = false; for (unsigned i = 0U; i < (unsigned)MM_LAMP_COUNT; i++) { const mm_lamp_map_t *m = &s_mm_lamp_map[i]; _mm_drive(m, false); pl_gpio_release_exti(m->port, m->pin); pl_gpio_config_output(m->port, m->pin); s_mm_lamp_state[i] = false; } mm_apply_lamp(MM_LAMP_RED, true); } static mm_lamp_t _mm_effective_lamp(mm_lamp_t lamp) { if (!s_mm_arrow_swapped) return lamp; if (lamp == MM_LAMP_LEFT) return MM_LAMP_RIGHT; if (lamp == MM_LAMP_RIGHT) return MM_LAMP_LEFT; return lamp; } bool mm_arrow_map_is_swapped(void) { return s_mm_arrow_swapped; } bool mm_arrow_map_toggle(void) { s_mm_arrow_swapped = !s_mm_arrow_swapped; return s_mm_arrow_swapped; } mm_parsed_cmd_t mm_parse_frame(const uint8_t *raw, uint16_t raw_len) { mm_parsed_cmd_t out = { .parsed = false, .cmd = MM_CMD_OTHER, .lamp = MM_LAMP_RED, .on = false, }; if (raw == NULL || raw_len != MM_FRAME_LEN) return out; if (raw[0] != MM_FRAME_HEAD || raw[1] != MM_FRAME_ADDR) return out; const uint8_t cmd_byte = raw[MM_CMD_OFFSET]; const uint8_t arg = raw[MM_ARG_OFFSET]; switch (cmd_byte) { case (uint8_t)MM_CMD_LANE_RED: out.lamp = MM_LAMP_RED; break; case (uint8_t)MM_CMD_LANE_LEFT: out.lamp = MM_LAMP_LEFT; break; case (uint8_t)MM_CMD_LANE_RIGHT: out.lamp = MM_LAMP_RIGHT; break; default: return out; } out.parsed = true; out.cmd = (mm_cmd_t)cmd_byte; out.on = (arg == 0x01U); return out; } void mm_execute_cmd(const mm_parsed_cmd_t *cmd) { if (cmd == NULL || !cmd->parsed) return; mm_apply_lamp(_mm_effective_lamp(cmd->lamp), cmd->on); } 