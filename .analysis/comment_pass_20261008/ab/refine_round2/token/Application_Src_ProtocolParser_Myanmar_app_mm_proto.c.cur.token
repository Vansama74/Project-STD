#include "app_mm_proto.h" #include "FreeRTOS.h" #include "initcall.h" #include "app_default_display.h" #include "app_dispatch.h" #include "dev_display.h" #include "pl_task_static.h" PL_TASK_STATIC_STORAGE(mm_handle, 256); RB_PROVIDE_WEAK(rb_provide_rs232, RB_SIZE_RS232); static proto_mask_t s_mm_mask; static osMessageQueueId_t s_mm_queue; [[gnu::section(".ccmram")]] static StaticQueue_t s_mm_queue_cb; [[gnu::section(".ccmram")]] static uint8_t s_mm_queue_buf[MM_QUEUE_DEPTH * MM_MSG_SIZE]; static const osMessageQueueAttr_t s_mm_queue_attr = { .name = "mm_queue", .cb_mem = &s_mm_queue_cb, .cb_size = sizeof(s_mm_queue_cb), .mq_mem = s_mm_queue_buf, .mq_size = sizeof(s_mm_queue_buf), }; static proto_probe_sta_t mm_probe_frame(const channel_t *ch, const ring_buffer_t *rb, uint32_t *total_len, uint8_t *aux); static void _mm_cross_px(dev_display_t *d, uint16_t w, uint16_t x, uint16_t y) { if (x < w) dev_display_set_pixel(d, x, y, COLOR_RED); } static void _mm_default_red_cross(void) { dev_display_t *d = dev_display_get(); if (d == nullptr) return; const uint16_t w = d->screen_rows; const uint16_t h = d->screen_cols; if (w < 2U || h < 2U) return; uint16_t thick = (uint16_t)(h / 24U); if (thick < 2U) thick = 2U; dev_display_fill(d, 0, 0, w, h, COLOR_BLACK); const uint16_t x_max = (uint16_t)(w - 1U); const uint16_t y_max = (uint16_t)(h - 1U); for (uint16_t y = 0U; y < h; y++) { const uint16_t x_l = (uint16_t)(((uint32_t)y * x_max) / y_max); const uint16_t x_r = (uint16_t)(x_max - x_l); for (uint16_t k = 0U; k < thick; k++) { _mm_cross_px(d, w, (uint16_t)(x_l + k), y); if (x_r >= k) _mm_cross_px(d, w, (uint16_t)(x_r - k), y); } } dev_display_commit_frame(d); } static void _mm_default_display_init(void) { if (dev_display_get() != nullptr) app_default_display_register(_mm_default_red_cross); } void mm_proto_init(void) { ring_buffer_t *rb = app_proto_acquire_buf(RB_SLOT_RS232, RB_SIZE_RS232); if (rb == nullptr) return; s_mm_mask = app_proto_register(mm_probe_frame, rb); if (s_mm_mask == 0) return; app_proto_bind_channel(s_mm_mask, CH_ID_RS232); _mm_default_display_init(); mm_apply_init(); s_mm_queue = osMessageQueueNew(MM_QUEUE_DEPTH, MM_MSG_SIZE, &s_mm_queue_attr); app_proto_set_frame_queue(s_mm_mask, s_mm_queue); static const osThreadAttr_t s_mm_task_attr = { .name = "mm_handle_task", .priority = osPriorityNormal, PL_TASK_STATIC_ATTR(mm_handle, 256), }; osThreadNew(mm_proto_handle_task, NULL, &s_mm_task_attr); } sw_app_initcall(mm_proto_init); static proto_probe_sta_t mm_probe_frame(const channel_t *ch, const ring_buffer_t *rb, uint32_t *total_len, uint8_t *aux) { (void)ch; (void)aux; uint32_t avail = rb_avail(rb, NULL); if (avail == 0U) return PROTO_PROBE_FAKE; uint8_t head; rb_peek(rb, 0U, &head, 1U, NULL); if (head != MM_FRAME_HEAD) return PROTO_PROBE_FAKE; if (avail < 2U) return PROTO_PROBE_WAIT; uint8_t addr; rb_peek(rb, 1U, &addr, 1U, NULL); if (addr != MM_FRAME_ADDR) return PROTO_PROBE_FAKE; if (avail < MM_FRAME_LEN) return PROTO_PROBE_WAIT; uint8_t cmd_arg[2]; rb_peek(rb, MM_CMD_OFFSET, cmd_arg, 2U, NULL); if (cmd_arg[0] != (uint8_t)MM_CMD_LANE_RED && cmd_arg[0] != (uint8_t)MM_CMD_LANE_LEFT && cmd_arg[0] != (uint8_t)MM_CMD_LANE_RIGHT) { uint8_t sig[MM_TAIL_SIG_LEN]; rb_peek(rb, MM_TAIL_SIG_OFFSET, sig, MM_TAIL_SIG_LEN, NULL); for (uint32_t i = 0U; i < MM_TAIL_SIG_LEN; i++) { if (sig[i] != MM_TAIL_SIG_VALUE) return PROTO_PROBE_FAKE; } *total_len = MM_FRAME_LEN; return PROTO_PROBE_SKIP; } if (cmd_arg[1] > 0x01U) { *total_len = MM_FRAME_LEN; return PROTO_PROBE_SKIP; } *total_len = MM_FRAME_LEN; return PROTO_PROBE_READY; } void mm_proto_handle_task(void *argument) { (void)argument; [[gnu::section(".ccmram")]] static uint8_t msg_buf[MM_MSG_SIZE]; frame_msg_t *msg = (frame_msg_t *)msg_buf; for (;;) { if (osOK != osMessageQueueGet(s_mm_queue, msg, NULL, osWaitForever)) continue; mm_parsed_cmd_t cmd = mm_parse_frame(msg->data, (uint16_t)msg->data_len); mm_execute_cmd(&cmd); } } 