 #include <stdint.h> #include "app_dispatch.h" #include "app_render.h" #define GZ_OL_GUIDE0 (0x54U) #define GZ_OL_GUIDE1 (0x43U) #define GZ_OL_GUIDE2 (0x4CU) #define GZ_OL_GUIDE3 (0x59U) #define GZ_OL_GUIDE_LEN (4U) #define GZ_OL_HEAD_LEN (16U) #define GZ_OL_LEN_OFFSET (8U) #define GZ_OL_CMD_OFFSET (12U) #define GZ_OL_DATA_OFFSET (16U) #define GZ_OL_TAIL (0x00U) #define GZ_OL_FRAME_LEN_MIN (17U) #define GZ_OL_FRAME_LEN_MAX (256U) #define GZ_OL_PAYLOAD_MAX (GZ_OL_FRAME_LEN_MAX) #define GZ_OL_QUEUE_DEPTH (3U) #define GZ_OL_MSG_SIZE (sizeof(frame_msg_t) + GZ_OL_PAYLOAD_MAX) _Static_assert(GZ_OL_PAYLOAD_MAX <= RB_SIZE_RS485, "GZ_OL frame must fit RS485 RB"); _Static_assert(GZ_OL_PAYLOAD_MAX <= RB_SIZE_RS232, "GZ_OL frame must fit RS232 RB"); _Static_assert(GZ_OL_PAYLOAD_MAX <= RB_SIZE_RJ45, "GZ_OL frame must fit RJ45 RB (UDP 10011)"); #define GZ_OL_DISPLAY_PREFIX_LEN (17U) #define GZ_OL_FONT_NAME_LEN (4U) #define GZ_OL_NET_PAYLOAD_LEN (14U) typedef enum { GZ_OL_PCMD_FAULT_QUERY = 0x10, GZ_OL_PCMD_DISPLAY = 0x20, GZ_OL_PCMD_CLEAR = 0x30, GZ_OL_PCMD_SET_IP = 0x40, GZ_OL_PCMD_SET_IP_ACK = 0x50, GZ_OL_PCMD_SEARCH = 0x60, GZ_OL_PCMD_SEARCH_ACK = 0x70, GZ_OL_PCMD_FULL_COLOR = 0x80, GZ_OL_PCMD_INVALID = 0xFF, } gz_ol_pcmd_t; typedef enum { GZ_OL_PARSE_OK = 0, GZ_OL_PARSE_ERR_FRAME, GZ_OL_PARSE_ERR_CMD, GZ_OL_PARSE_ERR_PARAM, } gz_ol_parse_sta_t; typedef struct { uint16_t x; uint16_t y; const char *text; uint16_t text_len; font_size_t font_size; font_type_t font_type; display_color_t color; } gz_ol_display_t; typedef struct { uint8_t ip[4]; uint8_t mask[4]; uint8_t gw[4]; uint16_t port; } gz_ol_setip_t; typedef struct { uint8_t r, g, b; } gz_ol_rgb_t; typedef struct { gz_ol_pcmd_t cmd; gz_ol_parse_sta_t sta; uint16_t data_len; const uint8_t *data; union { gz_ol_display_t display; gz_ol_setip_t setip; gz_ol_rgb_t rgb; } p; } gz_ol_parsed_cmd_t; gz_ol_parsed_cmd_t gz_ol_parse_frame(const uint8_t *raw, uint16_t raw_len); void gz_ol_execute_cmd(channel_t *ch, const gz_ol_parsed_cmd_t *cmd); void gz_ol_resume_auto_dim(void); void gz_ol_proto_handle_task(void *argument); void gz_ol_proto_init(void); 