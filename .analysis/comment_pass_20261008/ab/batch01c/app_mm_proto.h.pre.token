 #include <stdbool.h> #include <stdint.h> #include "app_dispatch.h" #define MM_FRAME_HEAD (0xFFU) #define MM_FRAME_ADDR (0xE0U) #define MM_CMD_OFFSET (2U) #define MM_ARG_OFFSET (3U) #define MM_DATA_LEN (12U) #define MM_TAIL_LEN (5U) #define MM_FRAME_LEN (3U + MM_DATA_LEN + MM_TAIL_LEN) #define MM_TAIL_SIG_OFFSET (MM_FRAME_LEN - MM_TAIL_LEN) #define MM_TAIL_SIG_LEN (MM_TAIL_LEN - 1U) #define MM_TAIL_SIG_VALUE (0x00U) #define MM_PAYLOAD_MAX (MM_FRAME_LEN) #define MM_QUEUE_DEPTH (3U) #define MM_MSG_SIZE (sizeof(frame_msg_t) + MM_PAYLOAD_MAX) _Static_assert(MM_PAYLOAD_MAX <= RB_SIZE_RS232, "MM frame must fit RS232 RB"); _Static_assert(MM_FRAME_LEN == 20U, "MM frame is fixed 20 bytes per protocol doc"); typedef enum { MM_CMD_LANE_RED = 0x90, MM_CMD_LANE_LEFT = 0x0A, MM_CMD_LANE_RIGHT = 0x0B, MM_CMD_OTHER = 0xFF, } mm_cmd_t; typedef enum { MM_LAMP_RED = 0, MM_LAMP_LEFT = 1, MM_LAMP_RIGHT = 2, MM_LAMP_COUNT = 3, } mm_lamp_t; typedef struct { bool parsed; mm_cmd_t cmd; mm_lamp_t lamp; bool on; } mm_parsed_cmd_t; mm_parsed_cmd_t mm_parse_frame(const uint8_t *raw, uint16_t raw_len); void mm_execute_cmd(const mm_parsed_cmd_t *cmd); bool mm_arrow_map_toggle(void); bool mm_arrow_map_is_swapped(void); void mm_apply_lamp(mm_lamp_t lamp, bool on); void mm_apply_init(void); void mm_proto_handle_task(void *argument); void mm_proto_init(void); 