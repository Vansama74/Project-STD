#include "app_factory_test.h" #include "cmsis_os2.h" #include "initcall.h" #include "app_mm_proto.h" #include "dev_key.h" #include "pl_task_guard.h" #include "pl_task_static.h" PL_TASK_STATIC_STORAGE(mm_factory_monitor, 256); osThreadId_t g_factory_test; static void mm_factory_monitor_task(void *argument) { (void)argument; for (;;) { if (!dev_key_wait_press(DEV_KEY_TST, osWaitForever)) continue; (void)mm_arrow_map_toggle(); } } static void _factory_test_init(void) { const osThreadAttr_t attr = { .name = "mm_factory_test", .priority = osPriorityHigh, PL_TASK_STATIC_ATTR(mm_factory_monitor, 256), }; g_factory_test = pl_task_create_checked(osThreadNew(mm_factory_monitor_task, NULL, &attr), "mm_factory_test"); } sw_app_initcall(_factory_test_init); void app_factory_mode_interrupt(void) { } bool app_factory_test_active(void) { return false; } 