#include "app_gz_ol_proto_cmd.h" #include <string.h> #include "app_board_net_cfg.h" #include "app_light_sensor.h" #include "app_render.h" #include "app_scroll.h" #include "cmsis_os2.h" #include "dev_display.h" #include "stm32f4xx_hal.h" static bool s_gz_ol_auto_dim_off; static void _gz_ol_send_frame(channel_t *ch, uint8_t cmd, const uint8_t *payload, uint16_t payload_len) { uint8_t buf[GZ_OL_HEAD_LEN + GZ_OL_NET_PAYLOAD_LEN + 1U]; if (payload_len > GZ_OL_NET_PAYLOAD_LEN) return; const uint16_t total = (uint16_t)(GZ_OL_HEAD_LEN + payload_len + 1U); buf[0] = GZ_OL_GUIDE0; buf[1] = GZ_OL_GUIDE1; buf[2] = GZ_OL_GUIDE2; buf[3] = GZ_OL_GUIDE3; buf[4] = 0U; buf[5] = 0U; buf[6] = 0U; buf[7] = 0U; buf[8] = (uint8_t)(total & 0xFFU); buf[9] = (uint8_t)(total >> 8); buf[10] = 0U; buf[11] = 0U; buf[12] = cmd; buf[13] = 0U; buf[14] = 0U; buf[15] = 0U; if (payload_len > 0U && payload != nullptr) memcpy(&buf[GZ_OL_DATA_OFFSET], payload, payload_len); buf[total - 1U] = GZ_OL_TAIL; channel_send(ch, buf, total); } static bool _gz_ol_net_payload(uint8_t *out) { app_board_net_cfg_t cfg; if (app_board_net_cfg_get(&cfg) != 0) return false; memcpy(&out[0], cfg.ip, 4); memcpy(&out[4], cfg.mask, 4); memcpy(&out[8], cfg.gw, 4); out[12] = (uint8_t)(cfg.port >> 8); out[13] = (uint8_t)(cfg.port & 0xFFU); return true; } static void _gz_ol_clear_screen(dev_display_t *d) { dev_display_fill(d, 0, 0, d->screen_rows, d->screen_cols, COLOR_BLACK); dev_display_commit_frame(d); } static uint16_t _gz_ol_text_unescape_nl(char *text, uint16_t len, uint16_t *out_nl) { uint16_t i = 0U, o = 0U, nl = 0U; while (i < len) { if (text[i] == 0x5CU && (i + 1U) < len && text[i + 1U] == 0x6EU) { text[o++] = 0x0AU; i += 2U; nl++; } else if (text[i] >= 0x81U && text[i] <= 0xFEU && (i + 1U) < len && text[i + 1U] >= 0x40U && text[i + 1U] <= 0xFEU && text[i + 1U] != 0x7FU) { text[o++] = text[i]; text[o++] = text[i + 1U]; i += 2U; } else { text[o++] = text[i]; i += 1U; } } if (out_nl != nullptr) *out_nl = nl; return o; } static void _gz_ol_exec_display(const gz_ol_parsed_cmd_t *cmd) { const gz_ol_display_t *p = &cmd->p.display; dev_display_t *d = dev_display_get(); if (d == nullptr) return; const uint16_t x = (p->x < d->screen_rows) ? p->x : 0U; const uint16_t y = (p->y < d->screen_cols) ? p->y : 0U; const uint16_t w = (uint16_t)(d->screen_rows - x); const uint16_t h = (uint16_t)(d->screen_cols - y); uint16_t text_len = p->text_len; if (text_len > 0U) text_len = _gz_ol_text_unescape_nl((char *)p->text, text_len, nullptr); app_scroll_render_lock(); _gz_ol_clear_screen(d); if (text_len > 0U) { app_render(&(render_cfg_t){ .type = RENDER_TEXT, .x = x, .y = y, .w = w, .h = h, .style = &(render_style_t){ .h_align = ALIGN_LEFT_UP, .v_align = ALIGN_LEFT_UP, .word_wrap = true, }, .color = p->color, .text = p->text, .len = text_len, .font_size = p->font_size, .font_type = p->font_type, .text_enc = FONT_ENC_GBK, }); dev_display_commit_frame(d); } app_scroll_render_unlock(); } static void _gz_ol_exec_clear(void) { dev_display_t *d = dev_display_get(); if (d == nullptr) return; app_scroll_render_lock(); _gz_ol_clear_screen(d); app_scroll_render_unlock(); } static void _gz_ol_exec_full_color(const gz_ol_rgb_t *rgb) { display_color_t color; if (rgb->r == 0xFF && rgb->g == 0x00 && rgb->b == 0x00) { color = COLOR_RED; } else if (rgb->r == 0x00 && rgb->g == 0xFF && rgb->b == 0x00) { color = COLOR_GREEN; } else if (rgb->r == 0x00 && rgb->g == 0x00 && rgb->b == 0xFF) { color = COLOR_YELLOW; } else { return; } if (g_light_sensor_task_handle != nullptr) { osThreadSuspend(g_light_sensor_task_handle); s_gz_ol_auto_dim_off = true; } dev_display_t *d = dev_display_get(); if (d == nullptr) return; dev_display_set_brightness(d, DEV_DISPLAY_BRIGHTNESS_MAX); app_scroll_render_lock(); dev_display_fill(d, 0, 0, d->screen_rows, d->screen_cols, color); dev_display_commit_frame(d); app_scroll_render_unlock(); } void gz_ol_resume_auto_dim(void) { if (!s_gz_ol_auto_dim_off) return; if (g_light_sensor_task_handle != nullptr) osThreadResume(g_light_sensor_task_handle); s_gz_ol_auto_dim_off = false; } static void _gz_ol_exec_set_ip(channel_t *ch, const gz_ol_parsed_cmd_t *cmd) { const gz_ol_setip_t *p = &cmd->p.setip; app_board_net_cfg_t cur; uint32_t udp_port = (app_board_net_cfg_get(&cur) == 0) ? cur.udp_port : 20103U; const int32_t wr_ret = app_board_net_cfg_update(p->ip, p->mask, p->gw, (uint32_t)p->port, udp_port); (void)wr_ret; uint8_t payload[GZ_OL_NET_PAYLOAD_LEN]; memcpy(&payload[0], p->ip, 4); memcpy(&payload[4], p->mask, 4); memcpy(&payload[8], p->gw, 4); payload[12] = (uint8_t)(p->port >> 8); payload[13] = (uint8_t)(p->port & 0xFFU); _gz_ol_send_frame(ch, GZ_OL_PCMD_SET_IP_ACK, payload, GZ_OL_NET_PAYLOAD_LEN); osDelay(100); NVIC_SystemReset(); } static void _gz_ol_exec_search(channel_t *ch) { uint8_t payload[GZ_OL_NET_PAYLOAD_LEN] = {0}; (void)_gz_ol_net_payload(payload); _gz_ol_send_frame(ch, GZ_OL_PCMD_SEARCH_ACK, payload, GZ_OL_NET_PAYLOAD_LEN); } static void _gz_ol_exec_fault_query(channel_t *ch) { const uint8_t sta[2] = {0x00U, 0x00U}; _gz_ol_send_frame(ch, GZ_OL_PCMD_FAULT_QUERY, sta, sizeof(sta)); } void gz_ol_execute_cmd(channel_t *ch, const gz_ol_parsed_cmd_t *cmd) { if (cmd == nullptr || cmd->sta != GZ_OL_PARSE_OK) return; switch (cmd->cmd) { case GZ_OL_PCMD_DISPLAY: _gz_ol_exec_display(cmd); break; case GZ_OL_PCMD_CLEAR: _gz_ol_exec_clear(); break; case GZ_OL_PCMD_FULL_COLOR: _gz_ol_exec_full_color(&cmd->p.rgb); break; case GZ_OL_PCMD_FAULT_QUERY: _gz_ol_exec_fault_query(ch); break; case GZ_OL_PCMD_SET_IP: _gz_ol_exec_set_ip(ch, cmd); break; case GZ_OL_PCMD_SEARCH: case GZ_OL_PCMD_SET_IP_ACK: _gz_ol_exec_search(ch); break; default: break; } } 